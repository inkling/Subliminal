{
  "name": "@inkling/magicbell-client",
  "version": "0.1.1",
  "description": "Shared UI components for Magic Bell",
  "main": "./dist/main.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "start": "yarn clean && webpack serve --open --mode development",
    "build": "yarn clean && webpack --mode production",
    "clean": "rm -rf dist/",
