{
  "name": "@inkling/magicbell-client",
  "version": "0.0.1",
  "description": "Shared UI components for Magic Bell",
  "main": "./dist/cjs/index.js",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js",
    "default": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "build": "npm-run-all clean build:cjs build:esm",
    "clean": "rm -rf dist/",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc",
    "prepublishOnly": "yarn build"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18",
    "react-dom": "18"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "react": "18",
    "react-dom": "18"
  }
}
