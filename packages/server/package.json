    "prepublishOnly": "yarn build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inkling/utils-logger": "^5.1.0",
    "magicbell": "^4.2.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
