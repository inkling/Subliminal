{
  "name": "@echo360/typescript-node-library-template",
  "version": "3.0.0",
  "description": "Template library for a modern Inkling TypeScript library.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js",
    "default": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts"
  },
  "files": [
    "./dist",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint ./src && prettier --check .",
    "format": "eslint ./src --fix && prettier --write .",
    "clean": "rm -rf ./dist",
    "test": "jest",
    "build": "npm-run-all clean build:static build:cjs build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc",
    "build:static": "mkdir -p dist && (cd static && cp -r . ../dist)",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Inkling",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.6.0"
  }
}
